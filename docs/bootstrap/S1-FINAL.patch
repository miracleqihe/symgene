+    const line = stripComments(raw)
+    if (!line.trim()) continue
+    if (line.startsWith(prefix) && !line.startsWith(prefix + ' ')) {
+      const rest = line.slice(prefix.length).replace(/^ +/, '')
+      const match = rest.match(/^([A-Za-z_][A-Za-z0-9_-]*|"[^"]+"):\s*(.*)$/)
+      if (match) {
