+
+test('F3: dynamic environment name in the deploy job fails closed (regression guard)', () => {
+  const codes = auditWorkflow(DYNAMIC_ENV_DEPLOY, 'deploy-pages.yml', { pagesJobs: GOOD_DEPLOY_PAGESJOBS }).map((v) => v.code)
