+    const kv = line.match(/^\s*([A-Za-z_-]+):\s*(.+)$/)
+    if (kv && !['name', 'uses', 'if', 'needs', 'runs-on', 'timeout-minutes', 'shell', 'working-directory'].includes(kv[1])) {
+      auditUntrustedInterpolation(kv[2], jobId, `input "${kv[1]}"`, add)
+    }
+  }
