+function auditUntrustedInterpolation(text, jobId, where, add) {
+  for (const m of text.matchAll(/\$\{\{\s*([^}]+?)\s*\}\}/g)) {
+    // Normalize bracket indexing to dot paths so `github['event']...` cannot
+    // evade the scanner; strip whitespace.
+    const expr = m[1]
+      .replace(/\[\s*'([^']+)'\s*\]/g, '.$1')
+      .replace(/\[\s*"([^"]+)"\s*\]/g, '.$1')
+      .replace(/\s+/g, '')
