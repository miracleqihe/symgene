+    if (quote) {
+      current += ch
+      if (ch === quote) quote = null
+      continue
+    }
+    if (ch === '"' || ch === "'") { quote = ch; current += ch; continue }
+    if (ch === '{' || ch === '[') { depth++; current += ch; continue }
+    if (ch === '}' || ch === ']') { depth--; current += ch; continue }
+    if (ch === sep && depth === 0) { parts.push(current); current = ''; continue }
+    current += ch
