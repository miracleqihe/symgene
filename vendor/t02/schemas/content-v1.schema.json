{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/symgene/schemas/content-1.0.0.json",
  "title": "SymGen content contract 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "contentVersion", "mode", "reviewSetId", "entities", "rights", "reviews", "redirects", "retractions"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "contentVersion": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"},
    "mode": {"enum": ["simulation", "public"]},
    "reviewSetId": {"$ref": "#/$defs/id"},
    "entities": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/entity"}},
    "rights": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/rights"}},
    "reviews": {"type": "array", "items": {"$ref": "#/$defs/review"}},
    "redirects": {"type": "array", "items": {"$ref": "#/$defs/redirect"}},
    "retractions": {"type": "array", "items": {"$ref": "#/$defs/retraction"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$"},
    "text": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "timestamp": {"type": "string", "format": "date-time"},
    "expiry": {"anyOf": [{"$ref": "#/$defs/timestamp"}, {"type": "null"}]},
    "sourcePayload": {
      "type": "object", "required": ["title"],
      "properties": {"title": {"$ref": "#/$defs/text"}}
    },
    "claimPayload": {
      "type": "object", "required": ["text"],
      "properties": {"text": {"$ref": "#/$defs/text"}}
    },
    "contentEntryPayload": {
      "type": "object",
      "properties": {"summary": {"$ref": "#/$defs/text"}, "name": {"$ref": "#/$defs/text"}, "title": {"$ref": "#/$defs/text"}},
      "anyOf": [{"properties": {"name": {}}, "required": ["name"]}, {"properties": {"title": {}}, "required": ["title"]}]
    },
    "genericTopicPayload": {
      "type": "object", "properties": {"summary": {}}, "required": ["summary"],
      "allOf": [{"$ref": "#/$defs/contentEntryPayload"}]
    },
    "scenarioPayload": {
      "type": "object",
      "properties": {"synthetic": {"const": true}}
    },
    "legacyDrugPayload": {
      "type": "object", "required": ["id", "name", "source", "sideEffects"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "name": {"$ref": "#/$defs/text"}, "source": {"$ref": "#/$defs/text"},
        "className": {"$ref": "#/$defs/text"}, "categoryLabel": {"$ref": "#/$defs/text"}, "sideEffects": {"$ref": "#/$defs/text"}
      },
      "anyOf": [{"properties": {"className": {}}, "required": ["className"]}, {"properties": {"categoryLabel": {}}, "required": ["categoryLabel"]}]
    },
    "legacyDisorderPayload": {
      "type": "object", "required": ["id", "name", "category", "summary", "source", "relatedDrugIds"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "name": {"$ref": "#/$defs/text"}, "category": {"$ref": "#/$defs/text"},
        "summary": {"$ref": "#/$defs/text"}, "source": {"$ref": "#/$defs/text"},
        "relatedDrugIds": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
      }
    },
    "legacyCasePayload": {
      "type": "object", "required": ["id", "title", "summary", "source", "disorderId"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "title": {"$ref": "#/$defs/text"}, "summary": {"$ref": "#/$defs/text"},
        "source": {"$ref": "#/$defs/text"}, "disorderId": {"$ref": "#/$defs/id"}
      }
    },
    "legacyResourcePayload": {
      "type": "object", "required": ["id", "title", "url"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "title": {"$ref": "#/$defs/text"}, "url": {"$ref": "#/$defs/text"}}
    },
    "legacyInstitutionPayload": {
      "type": "object", "required": ["id", "name", "province", "city", "lng", "lat", "category", "categoryLabel", "adcode", "source", "precision", "note"],
      "properties": {
        "id": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "integer", "minimum": 0}]},
        "name": {"$ref": "#/$defs/text"}, "province": {"$ref": "#/$defs/text"},
        "city": {"anyOf": [{"type": "string"}, {"type": "null"}]},
        "lng": {"type": "number", "minimum": -180, "maximum": 180},
        "lat": {"type": "number", "minimum": -90, "maximum": 90},
        "category": {"enum": ["specialized", "health-center", "counseling", "education", "related"]},
        "categoryLabel": {"$ref": "#/$defs/text"}, "adcode": {"type": "string", "pattern": "^[0-9]{6}$"},
        "source": {"$ref": "#/$defs/text"}, "precision": {"enum": ["address", "city", null]},
        "note": {"anyOf": [{"type": "string"}, {"type": "null"}]}
      }
    },
    "providerRef": {
      "type": "object", "additionalProperties": false,
      "required": ["provider", "namespace", "externalId"],
      "properties": {
        "provider": {"$ref": "#/$defs/id"},
        "namespace": {"$ref": "#/$defs/id"},
        "externalId": {"type": "string", "minLength": 1, "maxLength": 240}
      }
    },
    "legacy": {
      "type": "object", "additionalProperties": false,
      "required": ["collection", "id", "order"],
      "properties": {
        "collection": {"enum": ["drugs", "disorders", "cases", "resources", "institutions"]},
        "id": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "integer", "minimum": 0}]},
        "order": {"type": "integer", "minimum": 0}
      },
      "allOf": [{"if": {"properties": {"collection": {"enum": ["drugs", "disorders", "cases", "resources"]}}, "required": ["collection"]}, "then": {"properties": {"id": {"type": "string"}}}}]
    },
    "entity": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "type", "payload", "aliases", "providerRefs", "sourceIds", "claimIds", "rightsId"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "type": {"enum": ["source", "claim", "contentEntry", "scenario", "resource"]},
        "payload": {"type": "object"},
        "synthetic": {"type": "boolean"},
        "aliases": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
        "providerRefs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/providerRef"}},
        "sourceIds": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "claimIds": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "rightsId": {"$ref": "#/$defs/id"},
        "parentId": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
        "locator": {"anyOf": [{"type": "object", "minProperties": 1}, {"type": "null"}]},
        "locatorReason": {"$ref": "#/$defs/text"},
        "legacy": {"$ref": "#/$defs/legacy"}
      },
      "allOf": [
        {"if": {"properties": {"type": {"const": "source"}}, "required": ["type"]}, "then": {"properties": {"locator": {}, "payload": {"$ref": "#/$defs/sourcePayload"}}, "required": ["locator"]}},
        {"if": {"properties": {"locator": {"type": "null"}}, "required": ["locator"]}, "then": {"properties": {"locatorReason": {}}, "required": ["locatorReason"]}},
        {"if": {"properties": {"type": {"const": "claim"}}, "required": ["type"]}, "then": {"properties": {"sourceIds": {"type": "array", "minItems": 1}, "payload": {"$ref": "#/$defs/claimPayload"}}}},
        {"if": {"properties": {"type": {"const": "contentEntry"}}, "required": ["type"]}, "then": {"properties": {"payload": {"$ref": "#/$defs/contentEntryPayload"}}}},
        {"if": {"properties": {"type": {"const": "contentEntry"}}, "required": ["type"], "not": {"properties": {"legacy": {}}, "required": ["legacy"]}}, "then": {"properties": {"payload": {"$ref": "#/$defs/genericTopicPayload"}}}},
        {"if": {"properties": {"type": {"const": "scenario"}}, "required": ["type"]}, "then": {"properties": {"payload": {"$ref": "#/$defs/scenarioPayload"}, "synthetic": {"const": true}}, "required": ["synthetic"]}},
        {"if": {"properties": {"legacy": {"type": "object", "properties": {"collection": {"const": "drugs"}}, "required": ["collection"]}}, "required": ["legacy"]}, "then": {"properties": {"payload": {"$ref": "#/$defs/legacyDrugPayload"}}}},
        {"if": {"properties": {"legacy": {"type": "object", "properties": {"collection": {"const": "disorders"}}, "required": ["collection"]}}, "required": ["legacy"]}, "then": {"properties": {"payload": {"$ref": "#/$defs/legacyDisorderPayload"}}}},
        {"if": {"properties": {"legacy": {"type": "object", "properties": {"collection": {"const": "cases"}}, "required": ["collection"]}}, "required": ["legacy"]}, "then": {"properties": {"payload": {"$ref": "#/$defs/legacyCasePayload"}}}},
        {"if": {"properties": {"legacy": {"type": "object", "properties": {"collection": {"const": "resources"}}, "required": ["collection"]}}, "required": ["legacy"]}, "then": {"properties": {"payload": {"$ref": "#/$defs/legacyResourcePayload"}}}},
        {"if": {"properties": {"legacy": {"type": "object", "properties": {"collection": {"const": "institutions"}}, "required": ["collection"]}}, "required": ["legacy"]}, "then": {"properties": {"payload": {"$ref": "#/$defs/legacyInstitutionPayload"}}}}
      ]
    },
    "rights": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "status", "licenseId", "evidenceRef", "expiresAt"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "status": {"enum": ["approved", "unknown"]},
        "licenseId": {"$ref": "#/$defs/text"},
        "evidenceRef": {"type": "string", "minLength": 1},
        "expiresAt": {"$ref": "#/$defs/expiry"}
      }
    },
    "review": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "reviewSetId", "subjectId", "subjectDigest", "gate", "decision", "reviewerRef", "authority", "evidenceRef", "reviewedAt", "expiresAt"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "reviewSetId": {"$ref": "#/$defs/id"},
        "subjectId": {"$ref": "#/$defs/id"},
        "subjectDigest": {"$ref": "#/$defs/digest"},
        "gate": {"enum": ["facts", "medical", "rights", "privacy"]},
        "decision": {"enum": ["approved", "not_applicable", "pending", "rejected"]},
        "reviewerRef": {"$ref": "#/$defs/id"},
        "authority": {"enum": ["simulation", "human"]},
        "evidenceRef": {"type": "string", "minLength": 1},
        "reviewedAt": {"$ref": "#/$defs/timestamp"},
        "expiresAt": {"$ref": "#/$defs/expiry"}
      }
    },
    "redirect": {
      "type": "object", "additionalProperties": false, "required": ["from", "to"],
      "properties": {"from": {"$ref": "#/$defs/id"}, "to": {"$ref": "#/$defs/id"}}
    },
    "retraction": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "targetId", "sequence", "effectiveAt", "reasonCode"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "targetId": {"$ref": "#/$defs/id"},
        "sequence": {"type": "integer", "minimum": 1},
        "effectiveAt": {"$ref": "#/$defs/timestamp"},
        "reasonCode": {"$ref": "#/$defs/id"}
      }
    },
    "releaseManifest": {
      "type": "object", "additionalProperties": false,
      "required": ["documentType", "manifestVersion", "schemaVersion", "contentVersion", "mode", "reviewSetId", "pipelineCommit", "codeDigest", "files", "counts", "licenses", "reviewIds", "retractionIds", "retractionTargets", "retractionSequence", "earliestExpiry", "publisherIdentity", "determinism"],
      "properties": {
        "documentType": {"const": "release-manifest"},
        "manifestVersion": {"const": 1},
        "schemaVersion": {"const": "1.0.0"},
        "contentVersion": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"},
        "mode": {"enum": ["simulation", "public"]},
        "reviewSetId": {"$ref": "#/$defs/id"},
        "pipelineCommit": {"type": "string", "pattern": "^(?:uncommitted|[a-f0-9]{40}(?:-dirty)?)$"},
        "codeDigest": {"$ref": "#/$defs/digest"},
        "files": {
          "type": "array", "minItems": 7, "maxItems": 7,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["path", "sha256", "bytes"],
            "properties": {
              "path": {"enum": ["bundle.json", "sources.json", "rights.json", "reviews.json", "redirects.json", "retractions.json", "content-v1.schema.json"]},
              "sha256": {"$ref": "#/$defs/digest"},
              "bytes": {"type": "integer", "minimum": 0, "maximum": 20971520}
            }
          }
        },
        "counts": {
          "type": "object", "additionalProperties": false,
          "required": ["entities", "sources", "claims", "contentEntries", "scenarios", "resources", "rights", "reviews", "redirects", "retractions"],
          "properties": {
            "entities": {"type": "integer", "minimum": 1},
            "sources": {"type": "integer", "minimum": 0},
            "claims": {"type": "integer", "minimum": 0},
            "contentEntries": {"type": "integer", "minimum": 0},
            "scenarios": {"type": "integer", "minimum": 0},
            "resources": {"type": "integer", "minimum": 0},
            "rights": {"type": "integer", "minimum": 1},
            "reviews": {"type": "integer", "minimum": 0},
            "redirects": {"type": "integer", "minimum": 0},
            "retractions": {"type": "integer", "minimum": 0}
          }
        },
        "licenses": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
        "reviewIds": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "retractionIds": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "retractionTargets": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "retractionSequence": {"type": "integer", "minimum": 0},
        "earliestExpiry": {"$ref": "#/$defs/expiry"},
        "publisherIdentity": {
          "type": "object", "additionalProperties": false, "required": ["status", "authenticated"],
          "properties": {"status": {"const": "not_configured"}, "authenticated": {"const": false}}
        },
        "determinism": {
          "type": "object", "additionalProperties": false, "required": ["encoding", "newline", "serialization"],
          "properties": {"encoding": {"const": "utf-8"}, "newline": {"const": "LF"}, "serialization": {"const": "canonical-json+lf"}}
        }
      }
    }
  }
}
